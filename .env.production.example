# Production build — copy to .env.production before: npm run build
#
# Preferred when Nginx serves the SPA and proxies /api on the SAME host (your setup):
#   → no cross-origin issues between www and apex
VITE_API_URL=/api
#
# Or full URL if the API is on another domain:
# VITE_API_URL=https://congonews.news/api
# VITE_API_URL=https://api.congonews.news/api

# Optional: if your backend exposes RSS/Atom:
# VITE_RSS_FEED_URL=https://congonews.news/feed.xml
